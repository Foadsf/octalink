            },
            {
              "id": 38,
              "type": "Mux",
              "name": "F, x', theta, theta'",
              "x": 160,
              "y": 40,
              "params": {
                "inputs": "4"
              },
              "flipped": false
            },
            {
              "id": 39,
              "type": "Octave Function",
              "name": "x''",
              "x": 260,
              "y": 40,
              "params": {
                "expression": "((I+m*l^2)*(u_vec[0]-b*u_vec[1]+m*l*u_vec[3]^2*sin(u_vec[2]))+m*l*cos(u_vec[2])*m*g*l*sin(u_vec[2]))/((M+m)*(I+m*l^2)-(m*l*cos(u_vec[2]))^2)"
              },
              "flipped": false
            },
            {
              "id": 40,
              "type": "Octave Function",
              "name": "theta''",
              "x": 260,
              "y": 250,
              "params": {
                "expression": "(-(M+m)*m*g*l*sin(u_vec[2])-m*l*cos(u_vec[2])*(u_vec[0]-b*u_vec[1]+m*l*u_vec[3]^2*sin(u_vec[2])))/((M+m)*(I+m*l^2)-(m*l*cos(u_vec[2]))^2)"
              },
              "flipped": false
            },
            {
              "id": 41,
