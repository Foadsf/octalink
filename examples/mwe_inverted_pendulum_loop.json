              "name": "theta''",
              "x": 260,
              "y": 250,
              "params": {
                "expression": "(-u_vec[0]*l*cos(u_vec[2])-u_vec[1]*l*sin(u_vec[2]))/I"
              },
              "flipped": false
            },
            {
              "id": 65,
              "type": "Integrator",
              "name": "x'",
              "x": 450,
              "y": 40,
              "params": {},
              "flipped": false
            },
            {
              "id": 66,
              "type": "Integrator",
              "name": "x",
              "x": 600,
              "y": 40,
              "params": {},
              "flipped": false
            },
            {
              "id": 67,
              "type": "Integrator",
              "name": "theta'",
              "x": 450,
              "y": 250,
              "params": {},
              "flipped": false
            },
            {
              "id": 68,
              "type": "Integrator",
              "name": "theta",
              "x": 600,
              "y": 250,
              "params": {
                "initial_condition": "pi"
              },
              "flipped": false
            },
            {
              "id": 69,
              "type": "Mux",
              "name": "x'', theta, theta', theta''",
              "x": 780,
              "y": 400,
              "params": {
                "inputs": "4"
              },
              "flipped": false
            },
            {
              "id": 70,
              "type": "Octave Function",
              "name": "N",
              "x": 880,
              "y": 420,
              "params": {
                "expression": "m*(u_vec[0]-l*u_vec[2]^2*sin(u_vec[1])+l*u_vec[3]*cos(u_vec[1]))"
              },
              "flipped": false
            },
            {
              "id": 71,
              "type": "Mux",
              "name": "theta, theta', theta''",
              "x": 780,
              "y": 560,
              "params": {
                "inputs": "3"
              },
              "flipped": false
            },
            {
              "id": 72,
              "type": "Octave Function",
              "name": "P",
              "x": 880,
              "y": 575,
              "params": {
                "expression": "m*(l*u_vec[1]^2*cos(u_vec[0])+l*u_vec[2]*sin(u_vec[0])+g)"
              },
              "flipped": false
            },
