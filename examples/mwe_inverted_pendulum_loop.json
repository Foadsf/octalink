              },
              "flipped": false
            },
            {
              "id": 61,
              "type": "Mux",
              "name": "F, N, x'",
              "x": 170,
              "y": 40,
              "params": {
                "inputs": "3"
              },
              "flipped": false
            },
            {
              "id": 62,
              "type": "Octave Function",
              "name": "x''",
              "x": 260,
              "y": 40,
              "params": {
                "expression": "(u_vec[0]-u_vec[1]-b*u_vec[2])/M"
              },
              "flipped": false
            },
            {
              "id": 63,
              "type": "Mux",
              "name": "N, P, theta",
              "x": 170,
              "y": 250,
              "params": {
                "inputs": "3"
